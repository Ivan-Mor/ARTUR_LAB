<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IT-отдел</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main><nav><a href="${pageContext.request.contextPath}/controller?action=projects">Проекты</a><a href="${pageContext.request.contextPath}/controller?action=developers">Сотрудники</a><span><c:out value="${sessionScope.username}" /></span><form method="post" action="${pageContext.request.contextPath}/controller"><input type="hidden" name="action" value="logout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button>Выйти</button></form></nav><h1>Сотрудники</h1><table><thead><tr><th>Имя</th><th>Специальность</th><th>Отдел</th></tr></thead><tbody><c:forEach items="${developers}" var="developer"><tr><td><c:out value="${developer.name}"/></td><td><c:out value="${developer.specialty}"/></td><td><c:out value="${developer.department}"/></td></tr></c:forEach></tbody></table></main></body></html>
