<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IT-отдел</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main><nav><a href="${pageContext.request.contextPath}/controller?action=projects">Проекты</a><a href="${pageContext.request.contextPath}/controller?action=developers">Сотрудники</a><span><c:out value="${sessionScope.username}" /></span><form method="post" action="${pageContext.request.contextPath}/controller"><input type="hidden" name="action" value="logout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button>Выйти</button></form></nav><h1>Проекты отдела</h1><c:if test="${sessionScope.role == 'ADMIN'}"><p><a class="button" href="${pageContext.request.contextPath}/controller?action=edit">Добавить проект</a></p></c:if><table><thead><tr><th>Название</th><th>Описание</th><th>Ответственный</th><c:if test="${sessionScope.role == 'ADMIN'}"><th>Действия</th></c:if></tr></thead><tbody><c:forEach items="${projects}" var="project"><tr><td><c:out value="${project.name}"/></td><td><c:out value="${project.description}"/></td><td><c:out value="${project.developerName}"/></td><c:if test="${sessionScope.role == 'ADMIN'}"><td><a href="${pageContext.request.contextPath}/controller?action=edit&amp;id=${project.id}">Изменить</a><form method="post" action="${pageContext.request.contextPath}/controller"><input type="hidden" name="action" value="delete"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${project.id}"><button>Удалить</button></form></td></c:if></tr></c:forEach></tbody></table><c:if test="${empty projects}"><p>Проектов пока нет.</p></c:if></main></body></html>
