<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IT-отдел</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main><nav><a href="${pageContext.request.contextPath}/controller?action=projects">Проекты</a><a href="${pageContext.request.contextPath}/controller?action=developers">Сотрудники</a><span><c:out value="${sessionScope.username}" /></span><form method="post" action="${pageContext.request.contextPath}/controller"><input type="hidden" name="action" value="logout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button>Выйти</button></form></nav><h1>Проект</h1><form method="post" action="${pageContext.request.contextPath}/controller"><input type="hidden" name="action" value="save"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${empty project ? 0 : project.id}"><label>Название<input name="name" value="<c:out value="${project.name}"/>" required maxlength="100"></label><label>Описание<textarea name="description" required maxlength="500"><c:out value="${project.description}"/></textarea></label><label>Ответственный<select name="developerId" required><c:forEach items="${developers}" var="developer"><option value="${developer.id}" ${developer.id == project.developerId ? 'selected' : ''}><c:out value="${developer.name}"/></option></c:forEach></select></label><button>Сохранить</button></form></main></body></html>
