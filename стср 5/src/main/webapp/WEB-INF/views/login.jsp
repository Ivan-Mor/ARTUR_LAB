<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IT-отдел</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main><h1>Вход в систему</h1><p class="error"><c:out value="${error}"/></p><p><c:out value="${message}"/></p><form method="post" action="${pageContext.request.contextPath}/controller"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="login"><label>Логин<input name="username" required maxlength="30" autocomplete="username"></label><label>Пароль<input name="password" type="password" required maxlength="128" autocomplete="current-password"></label><button>Войти</button></form><p><a href="${pageContext.request.contextPath}/controller?action=register">Регистрация</a></p></main></body></html>
